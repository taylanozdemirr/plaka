---
import Plate from './Plate.astro';
import Icon from './Icon.astro';
import { formatPrice } from '../lib/format';
import { site, telHref } from '../data/site';

const finishes = [
	{ variant: 'tr', label: 'Klasik Beyaz', extra: 0, swatch: '#f1efe8', accent: '#173c86' },
	{ variant: 'app', label: 'Mat Karbon', extra: 0, swatch: '#101216', accent: '#f3f1ea' },
	{ variant: 'black', label: 'Obsidyen', extra: 300, swatch: '#0b0b0c', accent: '#d9bd8a' },
	{ variant: 'bone', label: 'Fildişi', extra: 150, swatch: '#e9e2d3', accent: '#a2814e' },
	{ variant: 'red', label: 'Bordo', extra: 400, swatch: '#3c0d14', accent: '#ece2d2' },
] as const;

const types = [
	{ key: 'normal', label: 'Normal', price: 1290, variant: 'tr', size: 'standart' },
	{ key: 'app', label: 'App', price: 1890, variant: 'app', size: 'standart' },
	{ key: 'koleksiyon', label: 'Koleksiyon', price: 3290, variant: 'black', size: 'standart' },
	{ key: 'motosiklet', label: 'Motosiklet', price: 990, variant: 'tr', size: 'kare' },
] as const;

const initialPrice = formatPrice(1890);
---

<div class="config">
	<div class="config__preview">
		<div class="config__stage">
			<div class="config__stage-top">
				<span class="pill-note"><span class="dot"></span> Canlı önizleme</span>
				<span class="micro">01 / 04</span>
			</div>

			<div class="config__glow" aria-hidden="true"></div>
			<div class="config__plate plate-stage" data-config-plate data-tilt>
				<Plate text="PLK 81" city="06" variant="app" size="standart" />
			</div>

			<div class="config__stage-bottom">
				<span class="micro">520 × 110 mm</span>
				<span class="micro">1.2 mm alüminyum</span>
				<span class="micro">3D kabartma</span>
			</div>
		</div>

		<div class="config__assurances">
			<div>
				<Icon name="medal" size={17} />
				<span><strong>2 yıl</strong> üretim garantisi</span>
			</div>
			<div>
				<Icon name="truck" size={17} />
				<span><strong>81 ile</strong> sigortalı kargo</span>
			</div>
			<div>
				<Icon name="phone" size={17} />
				<span><strong>Telefonla</strong> kolay sipariş</span>
			</div>
		</div>
	</div>

	<div class="config__panel">
		<span class="eyebrow">Kişiye özel</span>
		<h2 class="h2">Kendi <span class="serif">imzanızı</span> yaratın.</h2>
		<p class="lead">
			Şehir kodunuzu, harf ve rakam grubunuzu seçin; yüzey ile ölçüyü belirleyin. Atölyemiz
			gerisini tamamlasın.
		</p>

		<div class="config__group">
			<span class="config__label">Plaka tipi</span>
			<div class="config__types" role="group" aria-label="Plaka tipi">
				{types.map((type) => (
					<button
						class={`config__type ${type.key === 'app' ? 'is-active' : ''}`}
						type="button"
						data-type={type.key}
						data-price={type.price}
						data-variant={type.variant}
						data-size={type.size}
					>
						{type.label}
					</button>
				))}
			</div>
		</div>

		<div class="config__fields">
			<div class="field">
				<label for="config-city">Şehir</label>
				<input
					class="input config__input"
					id="config-city"
					type="text"
					inputmode="numeric"
					maxlength="2"
					value="06"
					data-config-city
				/>
			</div>
			<div class="field">
				<label for="config-letters">Harf grubu</label>
				<input
					class="input config__input"
					id="config-letters"
					type="text"
					maxlength="3"
					value="PLK"
					data-config-letters
				/>
			</div>
			<div class="field">
				<label for="config-numbers">Rakam grubu</label>
				<input
					class="input config__input"
					id="config-numbers"
					type="text"
					inputmode="numeric"
					maxlength="5"
					value="81"
					data-config-numbers
				/>
			</div>
		</div>

		<div class="config__group">
			<span class="config__label">
				Yüzey
				<span class="config__label-value" data-finish-label>Mat Karbon</span>
			</span>
			<div class="config__swatches">
				{finishes.map((finish) => (
					<button
						class={`swatch ${finish.variant === 'app' ? 'is-active' : ''}`}
						type="button"
						data-finish={finish.variant}
						data-finish-label={finish.label}
						data-finish-extra={finish.extra}
						aria-label={finish.label}
						title={finish.label}
					>
						<span
							class="swatch__dot"
							style={`--swatch:${finish.swatch};--swatch-accent:${finish.accent}`}
						></span>
						<span class="swatch__label">{finish.label}</span>
					</button>
				))}
			</div>
		</div>

		<div class="config__group">
			<span class="config__label">Ölçü</span>
			<div class="config__sizes" role="group" aria-label="Plaka ölçüsü">
				<button class="config__size is-active" type="button" data-size="standart" data-size-extra="0">
					Standart <span>520 × 110</span>
				</button>
				<button class="config__size" type="button" data-size="kare" data-size-extra="-100">
					Kare <span>340 × 230</span>
				</button>
				<button class="config__size" type="button" data-size="uzun" data-size-extra="0">
					Uzun <span>600 × 108</span>
				</button>
			</div>
		</div>

		<div class="config__bottom">
			<div class="config__price">
				<span class="micro">Tahmini fiyat</span>
				<strong data-config-price>{initialPrice}</strong>
				<span class="config__price-note">KDV dahil · kesin fiyat telefonda netleşir</span>
			</div>
			<div class="config__cta">
				<button class="btn btn--gold btn--lg" type="button" data-config-order>
					<Icon name="whatsapp" size={16} stroke={1.5} />
					WhatsApp ile Sipariş Ver
				</button>
				<a class="config__call" href={telHref}>
					<Icon name="phone" size={13} stroke={1.7} />
					ya da arayın: <strong>{site.phone}</strong>
				</a>
			</div>
		</div>

		<p class="config__note">
			<Icon name="info" size={14} />
			Özel tasarımlar dekoratif amaçlıdır. Resmî tescil işlemleri için yetkili kurumlara
			başvurulmalıdır.
		</p>
	</div>
</div>

<script>
	import { whatsappHref } from '../data/site';
	import { formatPrice } from '../lib/format';
	import { showToast } from '../lib/ui';

	const wrapper = document.querySelector<HTMLElement>('[data-config-plate]');
	const plate = wrapper?.querySelector<HTMLElement>('.plate');
	const cityEl = plate?.querySelector<HTMLElement>('.plate__city');
	const textEl = plate?.querySelector<HTMLElement>('.plate__letters');
	const priceEl = document.querySelector<HTMLElement>('[data-config-price]');
	const finishLabel = document.querySelector<HTMLElement>('[data-finish-label]');
	const orderButton = document.querySelector<HTMLButtonElement>('[data-config-order]');

	const cityInput = document.querySelector<HTMLInputElement>('[data-config-city]');
	const lettersInput = document.querySelector<HTMLInputElement>('[data-config-letters]');
	const numbersInput = document.querySelector<HTMLInputElement>('[data-config-numbers]');

	if (!plate || !cityEl || !textEl || !cityInput || !lettersInput || !numbersInput) {
		// The configurator is not on this page.
	} else {
		const state = {
			type: 'app',
			basePrice: 1890,
			finishExtra: 0,
			sizeExtra: 0,
			variant: 'app',
			size: 'standart',
			finishLabel: 'Mat Karbon',
		};

		const variants = ['tr', 'app', 'black', 'gold', 'bone', 'green', 'fr', 'de', 'red'];
		const sizes = ['standart', 'kare', 'motosiklet', 'uzun'];

		const updatePlate = () => {
			const city = cityInput.value.replace(/\D/g, '').slice(0, 2) || '06';
			const letters = lettersInput.value
				.replace(/[^a-zA-ZçÇğĞıİöÖşŞüÜ]/g, '')
				.slice(0, 3)
				.toLocaleUpperCase('tr');
			const numbers = numbersInput.value.replace(/\D/g, '').slice(0, 5);
			cityEl.textContent = city;
			textEl.textContent = `${letters || 'PLK'} ${numbers || '81'}`;
			plate.setAttribute('aria-label', `${city} ${letters || 'PLK'} ${numbers || '81'} plaka önizlemesi`);

			variants.forEach((variant) => plate.classList.remove(`plate--${variant}`));
			sizes.forEach((size) => plate.classList.remove(`plate--${size}`));
			plate.classList.add(`plate--${state.variant}`, `plate--${state.size}`);

			const total = state.basePrice + state.finishExtra + state.sizeExtra;
			if (priceEl) priceEl.textContent = formatPrice(total);
		};

		const typeButtons = Array.from(document.querySelectorAll<HTMLElement>('.config__types [data-type]'));
		const finishButtons = Array.from(document.querySelectorAll<HTMLElement>('.config__swatches [data-finish]'));
		const sizeButtons = Array.from(document.querySelectorAll<HTMLElement>('.config__sizes [data-size]'));

		const syncButtons = () => {
			typeButtons.forEach((button) => {
				button.classList.toggle('is-active', button.dataset.type === state.type);
			});
			finishButtons.forEach((button) => {
				button.classList.toggle('is-active', button.dataset.finish === state.variant);
			});
			sizeButtons.forEach((button) => {
				button.classList.toggle('is-active', button.dataset.size === state.size);
			});
			if (finishLabel) finishLabel.textContent = state.finishLabel;
		};

		typeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				state.type = button.dataset.type ?? 'app';
				state.basePrice = Number(button.dataset.price ?? 1890);
				state.variant = (button.dataset.variant ?? 'app') as string;
				state.size = (button.dataset.size ?? 'standart') as string;
				state.sizeExtra = 0;
				state.finishExtra = 0;
				state.finishLabel =
					state.variant === 'tr'
						? 'Klasik Beyaz'
						: state.variant === 'black'
							? 'Obsidyen'
							: 'Mat Karbon';
				syncButtons();
				updatePlate();
			});
		});

		finishButtons.forEach((button) => {
			button.addEventListener('click', () => {
				state.variant = button.dataset.finish ?? 'app';
				state.finishExtra = Number(button.dataset.finishExtra ?? 0);
				state.finishLabel = button.dataset.finishLabel ?? 'Mat Karbon';
				syncButtons();
				updatePlate();
			});
		});

		sizeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				state.size = button.dataset.size ?? 'standart';
				state.sizeExtra = Number(button.dataset.sizeExtra ?? 0);
				syncButtons();
				updatePlate();
			});
		});

		const normalize = (input: HTMLInputElement, mode: 'city' | 'letters' | 'numbers') => {
			input.addEventListener('input', () => {
				if (mode === 'city' || mode === 'numbers') {
					input.value = input.value.replace(/\D/g, '').slice(0, mode === 'city' ? 2 : 5);
				} else {
					input.value = input.value
						.replace(/[^a-zA-ZçÇğĞıİöÖşŞüÜ]/g, '')
						.slice(0, 3)
						.toLocaleUpperCase('tr');
				}
				updatePlate();
			});
		};

		normalize(cityInput, 'city');
		normalize(lettersInput, 'letters');
		normalize(numbersInput, 'numbers');

		orderButton?.addEventListener('click', () => {
			const city = cityInput.value.replace(/\D/g, '');
			const letters = lettersInput.value.trim();
			const numbers = numbersInput.value.replace(/\D/g, '');
			const cityNumber = Number(city);

			if (city.length !== 2 || cityNumber < 1 || cityNumber > 81) {
				showToast('Geçerli bir şehir kodu girin (01–81).', 'error');
				cityInput.focus();
				return;
			}
			if (letters.length < 1 || numbers.length < 1) {
				showToast('Harf ve rakam grubunu tamamlayın.', 'error');
				return;
			}

			const sizeLabel = state.size === 'kare' ? 'Kare (340 × 230)' : state.size === 'uzun' ? 'Uzun (600 × 108)' : 'Standart (520 × 110)';
			const total = formatPrice(state.basePrice + state.finishExtra + state.sizeExtra);
			const message = [
				'Merhaba, sitenizde tasarladığım plaka için sipariş vermek istiyorum:',
				`• Plaka: ${city} ${letters.toLocaleUpperCase('tr')} ${numbers}`,
				`• Tip: ${typeButtons.find((button) => button.dataset.type === state.type)?.textContent?.trim() ?? state.type}`,
				`• Yüzey: ${state.finishLabel}`,
				`• Ölçü: ${sizeLabel}`,
				`• Tahmini fiyat: ${total}`,
			].join('\n');
			window.open(whatsappHref(message), '_blank', 'noopener');
			showToast('Tasarımınız WhatsApp mesajına eklendi.', 'success');
		});

		syncButtons();
		updatePlate();
	}
</script>

<style>
	.config {
		display: grid;
		grid-template-columns: 1.02fr 0.98fr;
		gap: clamp(34px, 5vw, 78px);
		align-items: start;
	}

	.config__preview {
		position: sticky;
		top: calc(var(--header-h) + 26px);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.config__stage {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 440px;
		padding: 26px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(110% 100% at 50% 20%, rgba(201, 168, 106, 0.12), transparent 55%),
			radial-gradient(80% 80% at 90% 100%, rgba(35, 59, 112, 0.18), transparent 60%),
			linear-gradient(160deg, #12151b, #090a0d 75%);
		overflow: hidden;
		isolation: isolate;
	}

	.config__stage::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
		background-size: 46px 46px;
		mask-image: radial-gradient(75% 70% at 50% 45%, #000, transparent 78%);
		-webkit-mask-image: radial-gradient(75% 70% at 50% 45%, #000, transparent 78%);
		pointer-events: none;
	}

	.config__stage-top,
	.config__stage-bottom {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.config__stage-bottom {
		border-top: 1px solid var(--line);
		padding-top: 15px;
	}

	.config__glow {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 68%;
		height: 62%;
		transform: translate(-50%, -50%);
		background: rgba(201, 168, 106, 0.16);
		filter: blur(70px);
		border-radius: 50%;
		pointer-events: none;
	}

	.config__plate {
		position: relative;
		z-index: 2;
		width: 88%;
		margin: 34px auto;
		filter: drop-shadow(0 34px 40px rgba(0, 0, 0, 0.45));
	}

	.config__assurances {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--line);
		overflow: hidden;
	}

	.config__assurances > div {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px;
		background: #0b0d11;
		color: #8d919b;
		font-size: 10px;
		line-height: 1.4;
	}

	.config__assurances .icon {
		flex: 0 0 auto;
		color: var(--gold);
	}

	.config__assurances strong {
		font-weight: 650;
		color: var(--text-muted);
	}

	.config__panel {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.config__panel .h2 {
		max-width: 12ch;
	}

	.config__panel .lead {
		font-size: 13px;
		line-height: 1.75;
		max-width: 46ch;
	}

	.config__group {
		display: flex;
		flex-direction: column;
		gap: 11px;
		margin-top: 8px;
	}

	.config__label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.17em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.config__label-value {
		color: var(--gold);
		letter-spacing: 0.08em;
	}

	.config__types {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 6px;
		padding: 5px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.022);
	}

	.config__type {
		padding: 10px 6px;
		border-radius: 8px;
		font-size: 11px;
		font-weight: 650;
		color: var(--text-dim);
		transition:
			background 0.3s var(--ease-soft),
			color 0.3s,
			box-shadow 0.3s;
	}

	.config__type:hover {
		color: var(--text);
	}

	.config__type.is-active {
		background: rgba(255, 255, 255, 0.09);
		color: var(--text);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08) inset;
	}

	.config__fields {
		display: grid;
		grid-template-columns: 0.55fr 1fr 1fr;
		gap: 10px;
	}

	.config__input {
		min-height: 48px;
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 550;
		letter-spacing: 0.03em;
		text-align: center;
		text-transform: uppercase;
	}

	.config__swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.swatch {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 11px 7px 8px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--text-dim);
		font-size: 10px;
		font-weight: 600;
		transition:
			border-color 0.3s,
			color 0.3s,
			background 0.3s;
	}

	.swatch:hover {
		color: var(--text);
		border-color: var(--line-strong);
	}

	.swatch.is-active {
		border-color: rgba(201, 168, 106, 0.6);
		color: var(--text);
		background: rgba(201, 168, 106, 0.06);
	}

	.swatch__dot {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background:
			linear-gradient(140deg, rgba(255, 255, 255, 0.35), transparent 55%),
			var(--swatch);
		border: 1px solid rgba(255, 255, 255, 0.18);
		box-shadow: inset 3px 0 0 -1px var(--swatch-accent);
	}

	.config__sizes {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}

	.config__size {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 8px;
		border: 1px solid var(--line);
		border-radius: 9px;
		font-size: 10.5px;
		font-weight: 650;
		color: var(--text-muted);
		text-align: left;
		transition:
			border-color 0.3s,
			background 0.3s,
			color 0.3s;
	}

	.config__size span {
		font-size: 8.5px;
		font-weight: 500;
		color: var(--text-dim);
		letter-spacing: 0.04em;
	}

	.config__size:hover {
		border-color: var(--line-strong);
		color: var(--text);
	}

	.config__size.is-active {
		border-color: rgba(201, 168, 106, 0.55);
		background: rgba(201, 168, 106, 0.06);
		color: var(--text);
	}

	.config__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 22px;
		padding-top: 18px;
		margin-top: 4px;
		border-top: 1px solid var(--line);
	}

	.config__price {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.config__price strong {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.3vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		color: var(--gold-bright);
		line-height: 1.1;
	}

	.config__price-note {
		font-size: 9px;
		color: var(--text-dim);
		letter-spacing: 0.03em;
	}

	.config__cta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 9px;
	}

	.config__call {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 10.5px;
		color: var(--text-dim);
		transition: color 0.25s;
	}

	.config__call strong {
		color: var(--gold-bright);
		font-weight: 650;
		font-variant-numeric: tabular-nums;
	}

	.config__call:hover {
		color: var(--text);
	}

	.config__note {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 9.5px;
		line-height: 1.6;
		color: var(--text-dim);
	}

	.config__note .icon {
		flex: 0 0 auto;
		margin-top: 1px;
		color: var(--text-dim);
	}

	@media (max-width: 900px) {
		.config {
			grid-template-columns: 1fr;
		}
		.config__preview {
			position: relative;
			top: 0;
		}
		.config__stage {
			min-height: 340px;
		}
	}

	@media (max-width: 560px) {
		.config__stage {
