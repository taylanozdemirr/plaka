---
import Icon from './Icon.astro';
import { site, telHref, whatsappHref } from '../data/site';

interface Props {
	/** full: geniş bölüm kartı · compact: ürün sayfası gibi dar alanlar */
	variant?: 'full' | 'compact';
	eyebrow?: string;
	title?: string;
	lead?: string;
	/** WhatsApp'ta hazır gelecek mesaj */
	message?: string;
	class?: string;
}

const {
	variant = 'full',
	eyebrow = 'Sipariş hattı',
	title,
	lead,
	message,
	class: className = '',
} = Astro.props;

const [area, ...rest] = site.phone.split(' ');
---

<div class={`phone-cta phone-cta--${variant} ${className}`}>
	<span class="phone-cta__sheen" aria-hidden="true"></span>

	<div class="phone-cta__head">
		<span class="eyebrow eyebrow--plain">{eyebrow}</span>
		<span class="phone-cta__live">
			<span class="phone-cta__pulse" aria-hidden="true"></span>
			Telefonla sipariş
		</span>
	</div>

	{title && <h2 class="phone-cta__title" set:html={title} />}
	{lead && <p class="phone-cta__lead">{lead}</p>}

	<a class="phone-plate" href={telHref} aria-label={`${site.phone} numarasını ara`}>
		<span class="phone-plate__band" aria-hidden="true">
			<span class="phone-plate__stars"></span>
			<span>TR</span>
		</span>
		<span class="phone-plate__number">
			<span class="phone-plate__area">{area}</span>
			<span>{rest.join(' ')}</span>
		</span>
		<span class="phone-plate__screw phone-plate__screw--l" aria-hidden="true"></span>
		<span class="phone-plate__screw phone-plate__screw--r" aria-hidden="true"></span>
	</a>

	<div class="phone-cta__actions">
		<a class="btn btn--gold phone-cta__btn" href={telHref}>
			<Icon name="phone" size={15} stroke={1.7} />
			Hemen Arayın
		</a>
		<a class="btn btn--outline phone-cta__btn" href={whatsappHref(message)} target="_blank" rel="noopener">
			<Icon name="whatsapp" size={15} stroke={1.5} />
			WhatsApp’tan Yazın
		</a>
	</div>

	<div class="phone-cta__meta">
		<span><Icon name="clock" size={13} /> {site.hours}</span>
		<span><Icon name="truck" size={13} /> 81 ile sigortalı kargo</span>
	</div>
</div>

<style>
	.phone-cta {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: clamp(22px, 3vw, 34px);
		border: 1px solid rgba(201, 168, 106, 0.22);
		border-radius: var(--radius);
		background:
			radial-gradient(120% 90% at 100% 0%, rgba(201, 168, 106, 0.13), transparent 55%),
			radial-gradient(90% 80% at 0% 100%, rgba(28, 63, 148, 0.16), transparent 60%),
			linear-gradient(160deg, #11141a, #08090c 75%);
		box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.05);
		overflow: hidden;
		isolation: isolate;
	}

	.phone-cta__sheen {
		position: absolute;
		inset: -40% auto auto -30%;
		z-index: -1;
		width: 60%;
		height: 180%;
		background: linear-gradient(100deg, transparent, rgba(230, 205, 155, 0.06), transparent);
		transform: rotate(18deg);
		animation: phone-sheen 7s var(--ease-soft) infinite;
		pointer-events: none;
	}

	@keyframes phone-sheen {
		0%,
		55% {
			translate: 0 0;
		}
		100% {
			translate: 260% 0;
		}
	}

	.phone-cta__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}

	.phone-cta__live {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 11px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.phone-cta__pulse {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #63b98d;
	}

	.phone-cta__pulse::after {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 1px solid #63b98d;
		animation: phone-pulse 2s var(--ease-soft) infinite;
	}

	@keyframes phone-pulse {
		from {
			opacity: 0.9;
			transform: scale(0.6);
		}
		to {
			opacity: 0;
			transform: scale(1.6);
		}
	}

	.phone-cta__title {
		font-size: clamp(1.6rem, 2.8vw, 2.4rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1.08;
	}

	.phone-cta__lead {
		max-width: 52ch;
		font-size: 13px;
		line-height: 1.75;
		color: var(--text-muted);
	}

	/* Plate-styled phone number */
	.phone-plate {
		position: relative;
		display: flex;
		align-items: stretch;
		width: 100%;
		min-height: clamp(76px, 9vw, 104px);
		border-radius: 12px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 40%),
			linear-gradient(160deg, #15171c, #0a0b0d);
		box-shadow:
			0 0 0 1px rgba(201, 168, 106, 0.55),
			0 0 0 5px #0b0c0f,
			0 0 0 6px rgba(201, 168, 106, 0.25),
			0 30px 60px -30px rgba(0, 0, 0, 0.9),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
		overflow: hidden;
		transition:
			transform 0.5s var(--ease),
			box-shadow 0.5s var(--ease-soft);
	}

	.phone-plate:hover {
		transform: translateY(-3px);
		box-shadow:
			0 0 0 1px rgba(230, 205, 155, 0.9),
			0 0 0 5px #0b0c0f,
			0 0 0 6px rgba(201, 168, 106, 0.45),
			0 40px 80px -36px rgba(201, 168, 106, 0.45),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.phone-plate__band {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		gap: 6px;
		width: clamp(38px, 4.4vw, 52px);
		padding: 10px 0;
		background: linear-gradient(180deg, #1f48a6, #14306f);
		font-family: var(--font-display);
		font-size: clamp(11px, 1.2vw, 14px);
		font-weight: 700;
		color: #f4f1ea;
		letter-spacing: 0.04em;
	}

	.phone-plate__stars {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: repeating-conic-gradient(#e6cd9b 0 6deg, transparent 6deg 30deg);
		mask: radial-gradient(circle, transparent 6px, #000 6.5px, #000 8px, transparent 8.5px);
		-webkit-mask: radial-gradient(circle, transparent 6px, #000 6.5px, #000 8px, transparent 8.5px);
		opacity: 0.85;
	}

	.phone-plate__number {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35em;
		padding: 0 clamp(14px, 2vw, 28px);
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3.6vw, 2.75rem);
		font-weight: 650;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		background: linear-gradient(180deg, #f6e5bf 0%, #e6cd9b 45%, #a8854a 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
	}

	.phone-plate__area {
		opacity: 0.8;
	}

	.phone-plate__screw {
		position: absolute;
		top: 50%;
		width: 7px;
		height: 7px;
		margin-top: -3.5px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #d9dbe0, #6b6f78 70%);
		box-shadow: 0 1px 1px rgba(0, 0, 0, 0.6);
	}

	.phone-plate__screw--l {
		left: calc(clamp(38px, 4.4vw, 52px) + 10px);
	}

	.phone-plate__screw--r {
		right: 10px;
	}

	.phone-cta__actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	.phone-cta__btn {
		justify-content: center;
	}

	.phone-cta__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		font-size: 11px;
		color: var(--text-dim);
	}

	.phone-cta__meta span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}

	.phone-cta__meta .icon {
		color: var(--gold);
	}

	/* Compact */
	.phone-cta--compact {
		gap: 14px;
		padding: 18px;
		border-radius: 16px;
	}

	.phone-cta--compact .phone-plate {
		min-height: 70px;
	}

	.phone-cta--compact .phone-plate__number {
		font-size: clamp(1.3rem, 2.4vw, 1.85rem);
	}

	@media (max-width: 480px) {
		.phone-cta__actions {
			grid-template-columns: 1fr;
		}
		.phone-plate__screw {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.phone-cta__sheen,
		.phone-cta__pulse::after {
			animation: none;
		}
	}
</style>
