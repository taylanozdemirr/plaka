---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { legalPages } from '../../data/legal';
import { site, telHref } from '../../data/site';

export function getStaticPaths() {
	return legalPages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
}

const { page } = Astro.props;
const others = legalPages.filter((item) => item.slug !== page.slug);

const slugify = (value: string) =>
	value
		.toLowerCase()
		.replaceAll('ı', 'i')
		.replaceAll('ğ', 'g')
		.replaceAll('ü', 'u')
		.replaceAll('ş', 's')
		.replaceAll('ö', 'o')
		.replaceAll('ç', 'c')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');

const sections = page.sections.map((section) => ({
	...section,
	id: slugify(section.heading),
}));

const updated = new Date(page.updated).toLocaleDateString('tr-TR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<BaseLayout title={page.title} description={page.intro}>
	<PageHero
		eyebrow={page.eyebrow}
		title={page.title}
		lead={page.intro}
		crumbs={[
			{ label: 'Ana Sayfa', href: '/' },
			{ label: 'Bilgi', href: '/bilgi/gizlilik-politikasi' },
			{ label: page.title },
		]}
	>
		<div slot="aside" class="legal-hero__meta">
			<span class="micro">Son güncelleme</span>
			<strong>{updated}</strong>
			<span class="legal-hero__note">
				<Icon name="shield" size={12} />
				{site.name}
			</span>
		</div>
	</PageHero>

	<section class="legal">
		<div class="container legal__grid">
			<aside class="legal__toc">
				<span class="eyebrow eyebrow--plain">İçindekiler</span>
				<nav aria-label="Sayfa içi başlıklar">
					{sections.map((section, index) => (
						<a href={`#${section.id}`}>
							<span class="legal__toc-no">{String(index + 1).padStart(2, '0')}</span>
							<span>{section.heading}</span>
						</a>
					))}
				</nav>

				<div class="legal__toc-contact">
					<Icon name="headset" size={15} />
					<div>
						<strong>Sorunuz mu var?</strong>
						<a href="/iletisim">Atölyeye yazın</a>
					</div>
				</div>
			</aside>

			<article class="legal__article">
				<header class="legal__head">
					<span class="eyebrow">{page.eyebrow}</span>
					<h1>{page.title}</h1>
					<p>{page.intro}</p>
					<div class="legal__head-meta">
						<span><Icon name="clock" size={12} /> Güncelleme: {updated}</span>
						<span><Icon name="info" size={12} /> Bilgilendirme amaçlıdır</span>
					</div>
				</header>

				{sections.map((section, index) => (
					<section class="legal__section" id={section.id}>
						<h2>
							<span class="legal__no">{String(index + 1).padStart(2, '0')}</span>
							{section.heading}
						</h2>
						{section.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
						{section.bullets && (
							<ul class="legal__list">
								{section.bullets.map((bullet) => (
									<li>
										<Icon name="check" size={12} stroke={2} />
										<span>{bullet}</span>
									</li>
								))}
							</ul>
						)}
					</section>
				))}

				<div class="legal__callout">
					<Icon name="shield" size={17} />
					<div>
						<strong>Veri sorumlusu</strong>
						<p>
							{site.name} · Sipariş hattı: <a href={telHref}>{site.phone}</a>
						</p>
					</div>
				</div>

				<footer class="legal__foot">
					<span class="micro">Diğer bilgiler</span>
					<div class="legal__links">
						{others.map((item) => (
							<a href={`/bilgi/${item.slug}`}>
								{item.title}
								<Icon name="arrow-right" size={12} />
							</a>
						))}
					</div>
					<a class="btn btn--outline btn--sm legal__back" href="/">
						<Icon name="arrow-left" size={13} />
						Ana sayfaya dön
					</a>
				</footer>
			</article>
		</div>
	</section>
</BaseLayout>

<style>
	.legal-hero__meta {
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 14px 18px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.025);
	}

	.legal-hero__meta strong {
		font-family: var(--font-display);
		font-size: 12.5px;
		font-weight: 550;
		letter-spacing: -0.02em;
		color: var(--text-muted);
	}

	.legal-hero__note {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 4px;
		font-size: 9px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.legal-hero__note .icon {
		color: var(--gold);
	}

	.legal {
		padding: 0 0 clamp(64px, 8vw, 110px);
	}

	.legal__grid {
		display: grid;
		grid-template-columns: 250px minmax(0, 1fr);
		gap: clamp(26px, 4vw, 64px);
		align-items: start;
		padding-top: clamp(30px, 4vw, 48px);
		border-top: 1px solid var(--line);
	}

	.legal__toc {
		position: sticky;
		top: calc(var(--header-h) + 26px);
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.legal__toc nav {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.legal__toc nav a {
		display: flex;
		align-items: baseline;
		gap: 10px;
		padding: 8px 0;
		font-size: 11px;
		line-height: 1.4;
		color: var(--text-dim);
		border-bottom: 1px solid var(--line);
		transition: color 0.25s;
	}

	.legal__toc nav a:hover {
		color: var(--gold-bright);
	}

	.legal__toc-no {
		font-family: var(--font-display);
		font-size: 8.5px;
		font-weight: 650;
		letter-spacing: 0.06em;
		color: var(--gold);
	}

	.legal__toc-contact {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 14px;
		margin-top: 6px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.018);
	}

	.legal__toc-contact .icon {
		flex: 0 0 auto;
		margin-top: 1px;
		color: var(--gold);
	}

	.legal__toc-contact div {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.legal__toc-contact strong {
		font-size: 10.5px;
		font-weight: 650;
		color: var(--text-muted);
	}

	.legal__toc-contact a {
		font-size: 10.5px;
		font-weight: 600;
		color: var(--gold-bright);
	}

	.legal__article {
		max-width: 760px;
	}

	.legal__head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-bottom: clamp(24px, 3vw, 36px);
		border-bottom: 1px solid var(--line);
	}

	.legal__head h1 {
		font-size: clamp(2.1rem, 4vw, 3.4rem);
		line-height: 1;
		letter-spacing: -0.055em;
		font-weight: 430;
	}

	.legal__head p {
		max-width: 66ch;
		font-size: 13px;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.legal__head-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		font-size: 9.5px;
		letter-spacing: 0.06em;
		color: var(--text-dim);
	}

	.legal__head-meta span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.legal__head-meta .icon {
		color: var(--gold);
	}

	.legal__section {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: clamp(22px, 3vw, 34px) 0;
		border-bottom: 1px solid var(--line);
		scroll-margin-top: calc(var(--header-h) + 28px);
	}

	.legal__section h2 {
		display: flex;
		align-items: baseline;
		gap: 12px;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 500;
		letter-spacing: -0.04em;
	}

	.legal__no {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--gold);
	}

	.legal__section p {
		font-size: 12.5px;
		line-height: 1.85;
		color: var(--text-muted);
	}

	.legal__list {
		display: flex;
		flex-direction: column;
		gap: 9px;
		padding: 6px 0 2px;
	}

	.legal__list li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 12px;
		line-height: 1.7;
		color: var(--text-muted);
	}

	.legal__list .icon {
		flex: 0 0 auto;
		margin-top: 4px;
		color: var(--gold);
	}

	.legal__callout {
		display: flex;
		align-items: flex-start;
		gap: 13px;
		padding: 18px;
		margin-top: 26px;
		border: 1px solid rgba(201, 168, 106, 0.24);
		border-radius: 13px;
		background: rgba(201, 168, 106, 0.05);
	}

	.legal__callout .icon {
		flex: 0 0 auto;
		margin-top: 1px;
		color: var(--gold);
	}

	.legal__callout div {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.legal__callout strong {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.legal__callout p {
		font-size: 11px;
		line-height: 1.7;
		color: var(--text-muted);
	}

	.legal__callout a {
		color: var(--gold-bright);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.legal__foot {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-top: 30px;
	}

	.legal__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
	}

	.legal__links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 12px 14px;
		border: 1px solid var(--line);
		border-radius: 10px;
		font-size: 10.5px;
		font-weight: 600;
		color: var(--text-muted);
		transition:
			border-color 0.3s,
			color 0.3s,
			background 0.3s;
	}

	.legal__links a:hover {
		border-color: rgba(201, 168, 106, 0.35);
		background: rgba(201, 168, 106, 0.05);
		color: var(--text);
	}

	.legal__links .icon {
		color: var(--gold);
	}

	.legal__back {
		align-self: flex-start;
		margin-top: 8px;
	}

	@media (max-width: 940px) {
		.legal__grid {
			grid-template-columns: 1fr;
		}
		.legal__toc {
			position: relative;
			top: 0;
		}
		.legal__toc nav {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0 18px;
		}
		.legal__toc-contact {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.legal__links {
			grid-template-columns: 1fr;
		}
	}
</style>
