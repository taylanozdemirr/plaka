---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { faqCategories, faqs } from '../data/faq';
import { site, telHref, whatsappHref } from '../data/site';

const counts = faqCategories.map((category) => ({
	label: category,
	count: faqs.filter((faq) => faq.category === category).length,
}));
---

<BaseLayout
	title="Sıkça Sorulan Sorular"
	description="Plaka Atelier hakkında merak edilenler: malzeme, üretim süresi, telefonla sipariş, kargo, iade ve kişiye özel plaka soruları."
>
	<PageHero
		eyebrow="Yardım merkezi"
		title={`Aklınızda <span class="serif">bir soru</span> kalmasın.`}
		lead="Malzemeden kargoya, siparişten kişiye özel üretime kadar en sık sorulan soruları tek yerde topladık. Cevabını bulamadığınız bir şey olursa atölye ekibi bir telefon uzağınızda."
		crumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'SSS' }]}
	>
		<div slot="aside" class="faq-hero__card">
			<span class="faq-hero__icon"><Icon name="headset" size={20} stroke={1.4} /></span>
			<div>
				<span class="micro">Sipariş hattı</span>
				<strong>{site.hours}</strong>
				<a href={telHref}>{site.phone}</a>
			</div>
			<a class="faq-hero__link" href={telHref}>
				Arayın
				<Icon name="arrow-up-right" size={13} />
			</a>
		</div>
	</PageHero>

	<section class="faq-page">
		<div class="container">
			<div class="faq-toolbar">
				<div class="faq-chips" role="group" aria-label="Soru kategorileri">
					<button class="faq-chip is-active" type="button" data-faq-filter="all">
						Tümü
						<span>{faqs.length}</span>
					</button>
					{counts.map((item) => (
						<button class="faq-chip" type="button" data-faq-filter={item.label}>
							{item.label}
							<span>{item.count}</span>
						</button>
					))}
				</div>

				<label class="faq-search">
					<Icon name="search" size={15} stroke={1.6} />
					<input type="search" placeholder="Soru ara…" aria-label="Sorularda ara" data-faq-search />
					<button type="button" class="faq-search__clear" aria-label="Aramayı temizle" data-faq-clear hidden>
						<Icon name="close" size={13} />
					</button>
				</label>
			</div>

			<p class="faq-status micro" data-faq-status>{faqs.length} soru gösteriliyor</p>

			<div class="faq-groups">
				{faqCategories.map((category, groupIndex) => (
					<section class="faq-group" data-faq-group={category}>
						<header class="faq-group__head">
							<h2>{category}</h2>
							<span class="micro">
								{counts.find((item) => item.label === category)?.count ?? 0} soru
							</span>
						</header>
						<div class="faq-group__list">
							{faqs
								.filter((faq) => faq.category === category)
								.map((faq, index) => (
									<details
										class="faq-entry"
										data-faq-item
										data-category={category}
										data-search={faq.question.toLowerCase()}
										open={groupIndex === 0 && index === 0}
									>
										<summary>
											<span class="faq-entry__q">{faq.question}</span>
											<span class="faq-entry__icon" aria-hidden="true">
												<Icon name="plus" size={15} stroke={1.6} />
											</span>
										</summary>
										<div class="faq-entry__a">{faq.answer}</div>
									</details>
								))}
						</div>
					</section>
				))}
			</div>

			<div class="faq-empty" data-faq-empty hidden>
				<span class="faq-empty__icon"><Icon name="search" size={24} stroke={1.3} /></span>
				<h2>Sonuç bulunamadı</h2>
				<p>
					Aradığınız kelimeyle eşleşen bir soru yok. Farklı bir ifade deneyin ya da
					doğrudan bizi arayın.
				</p>
				<a class="btn btn--gold btn--sm" href={telHref}>
					Atölyeyi arayın
					<Icon name="arrow-right" size={13} />
				</a>
			</div>

			<div class="faq-cta reveal">
				<div class="faq-cta__copy">
					<span class="eyebrow">Cevabını bulamadınız mı?</span>
					<h2>Atölye ekibi <span class="serif">yanınızda.</span></h2>
					<p>
						Sipariş, ölçü veya özel üretim hakkında her soruyu telefonda
						yanıtlıyoruz. {site.hours}.
					</p>
				</div>
				<div class="faq-cta__actions">
					<a class="btn btn--gold" href={telHref}>
						<Icon name="phone" size={14} />
						{site.phone}
					</a>
					<a class="btn btn--ghost" href={whatsappHref()} target="_blank" rel="noopener">
						<Icon name="whatsapp" size={14} />
						WhatsApp’tan yazın
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.faq-hero__card {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.025);
	}

	.faq-hero__icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		flex: 0 0 40px;
		border: 1px solid rgba(201, 168, 106, 0.28);
		border-radius: 50%;
		background: rgba(201, 168, 106, 0.07);
		color: var(--gold);
	}

	.faq-hero__card > div {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.faq-hero__card strong {
		font-size: 10.5px;
		font-weight: 600;
		color: var(--text-muted);
	}

	.faq-hero__card a {
		font-size: 11px;
		font-weight: 650;
		color: var(--gold-bright);
	}

	.faq-hero__link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		margin-left: 8px;
		font-size: 9px;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-dim);
		transition: color 0.25s;
	}

	.faq-hero__link:hover {
		color: var(--gold-bright);
	}

	.faq-page {
		padding: 0 0 clamp(64px, 8vw, 110px);
	}

	.faq-toolbar {
		position: sticky;
		top: calc(var(--header-h) + 1px);
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		padding: 14px 0;
		margin-bottom: 6px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(18px);
	}

	.faq-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.faq-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 9px 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 10px;
		font-weight: 650;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		transition:
			border-color 0.3s,
			color 0.3s,
			background 0.3s;
	}

	.faq-chip span {
		font-size: 8.5px;
		font-weight: 700;
		color: var(--text-dim);
	}

	.faq-chip:hover {
		border-color: var(--line-strong);
		color: var(--text);
	}

	.faq-chip.is-active {
		border-color: rgba(201, 168, 106, 0.45);
		background: rgba(201, 168, 106, 0.09);
		color: var(--gold-bright);
	}

	.faq-chip.is-active span {
		color: var(--gold);
	}

	.faq-search {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 220px;
		padding: 0 12px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--input-bg);
		color: var(--text-dim);
		transition: border-color 0.3s;
	}

	.faq-search:focus-within {
		border-color: rgba(201, 168, 106, 0.5);
	}

	.faq-search input {
		flex: 1;
		min-width: 0;
		padding: 10px 0;
		border: 0;
		background: transparent;
		font-size: 11.5px;
		color: var(--text);
		outline: none;
	}

	.faq-search input::placeholder {
		color: var(--input-placeholder);
	}

	.faq-search input::-webkit-search-cancel-button {
		display: none;
	}

	.faq-search__clear {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		color: var(--text-dim);
		transition: color 0.25s;
	}

	.faq-search__clear:hover {
		color: var(--text);
	}

	.faq-status {
		padding: 14px 0 26px;
	}

	.faq-groups {
		display: flex;
		flex-direction: column;
		gap: clamp(28px, 4vw, 46px);
	}

	.faq-group[hidden] {
		display: none;
	}

	.faq-group__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
	}

	.faq-group__head h2 {
		font-family: var(--font-display);
		font-size: 14px;
		font-weight: 550;
		letter-spacing: -0.02em;
	}

	.faq-group__list {
		display: flex;
		flex-direction: column;
	}

	.faq-entry {
		border-bottom: 1px solid var(--line);
	}

	.faq-entry[hidden] {
		display: none;
	}

	.faq-entry summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 18px 4px;
		cursor: pointer;
		list-style: none;
		transition: color 0.3s;
	}

	.faq-entry summary::-webkit-details-marker {
		display: none;
	}

	.faq-entry summary:hover .faq-entry__q {
		color: var(--gold-bright);
	}

	.faq-entry__q {
		font-size: 13px;
		font-weight: 550;
		letter-spacing: -0.01em;
		transition: color 0.3s;
	}

	.faq-entry__icon {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		flex: 0 0 26px;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--text-dim);
		transition:
			transform 0.4s var(--ease),
			color 0.3s,
			border-color 0.3s;
	}

	.faq-entry[open] .faq-entry__icon {
		transform: rotate(45deg);
		border-color: rgba(201, 168, 106, 0.4);
		color: var(--gold);
	}

	.faq-entry[open] .faq-entry__q {
		color: var(--text);
	}

	.faq-entry__a {
		max-width: 84ch;
		padding: 0 4px 20px;
		font-size: 12px;
		line-height: 1.8;
		color: var(--text-muted);
		animation: faq-in 0.4s var(--ease) both;
	}

	@keyframes faq-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.faq-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 10px;
		padding: clamp(40px, 6vw, 72px) 20px;
	}

	.faq-empty[hidden] {
		display: none;
	}

	.faq-empty__icon {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--gold);
	}

	.faq-empty h2 {
		font-size: 22px;
		letter-spacing: -0.04em;
	}

	.faq-empty p {
		max-width: 44ch;
		margin-bottom: 8px;
		font-size: 12px;
		line-height: 1.7;
		color: var(--text-muted);
	}

	.faq-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: clamp(40px, 5vw, 64px);
		padding: clamp(24px, 3.4vw, 38px);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(100% 140% at 0% 0%, rgba(201, 168, 106, 0.1), transparent 55%),
			linear-gradient(160deg, #121519, #08090c 72%);
	}

	.faq-cta__copy {
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 54ch;
	}

	.faq-cta__copy h2 {
		font-size: clamp(1.5rem, 2.6vw, 2.1rem);
		letter-spacing: -0.045em;
		font-weight: 430;
	}

	.faq-cta__copy p {
		font-size: 12px;
		line-height: 1.7;
		color: var(--text-muted);
	}

	.faq-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	@media (max-width: 760px) {
		.faq-toolbar {
			position: relative;
			top: 0;
		}
		.faq-search {
			width: 100%;
		}
		.faq-cta__actions .btn {
			width: 100%;
		}
		.faq-hero__card {
			display: none;
		}
	}
</style>

<script>
	const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-faq-filter]'));
	const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-group]'));
	const search = document.querySelector<HTMLInputElement>('[data-faq-search]');
	const clear = document.querySelector<HTMLElement>('[data-faq-clear]');
	const status = document.querySelector<HTMLElement>('[data-faq-status]');
	const empty = document.querySelector<HTMLElement>('[data-faq-empty]');

	let activeCategory = 'all';

	const apply = () => {
		const query = (search?.value ?? '').trim().toLowerCase();
		let visible = 0;

		items.forEach((item) => {
			const categoryOk = activeCategory === 'all' || item.dataset.category === activeCategory;
			const searchOk = !query || (item.dataset.search ?? '').includes(query);
			const show = categoryOk && searchOk;
			item.hidden = !show;
			if (show) visible += 1;
		});

		groups.forEach((group) => {
			const hasVisible = group.querySelectorAll<HTMLElement>('[data-faq-item]:not([hidden])').length > 0;
			group.hidden = !hasVisible;
		});

		if (status) status.textContent = `${visible} soru gösteriliyor`;
		if (empty) empty.hidden = visible !== 0;
		if (clear) clear.hidden = query.length === 0;
	};

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.faqFilter ?? 'all';
			filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
			apply();
		});
	});

	search?.addEventListener('input', apply);

	clear?.addEventListener('click', () => {
		if (search) {
			search.value = '';
			search.focus();
		}
		apply();
	});

	apply();
</script>
